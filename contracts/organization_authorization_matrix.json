{
  "schemaVersion": 1,
  "legacyOrganizationId": "legacy-gironde",
  "roles": [
    "organization_admin",
    "coordinator",
    "site_manager",
    "professional"
  ],
  "permissions": [
    "read_organization",
    "read_operations",
    "manage_operations",
    "manage_coordinators",
    "manage_site_managers",
    "manage_sites",
    "view_actors",
    "view_statistics",
    "view_history",
    "export_data",
    "manage_invitations"
  ],
  "comparableOutputs": [
    "hasActiveMembership",
    "usesLegacyFallback",
    "isPlatformAdministrator",
    "isOrganizationAdmin",
    "isCoordinator",
    "isSiteManager",
    "isProfessional",
    "hasOrganizationAccess",
    "roles",
    "allowedPermissions"
  ],
  "layerSpecificConcepts": {
    "dart": [
      "OrganizationResponsibleAccessResolver porte le périmètre locationIds des parcours Coordinateur et Responsable en dehors de OrganizationAuthorizationService.",
      "Le service reçoit des legacyRoleValues déjà validées et actives par la couche d'identité RC3."
    ],
    "functions": [
      "resolveOrganizationAuthorization expose membershipPresent et membershipValid pour le diagnostic interne.",
      "resolveOrganizationAuthorization conserve locationIds et canReadOrganizationMissionTeam applique le périmètre Site.",
      "La couche Functions parse le document roles/{uid} brut, y compris active et son schéma."
    ]
  },
  "scenarios": [
    {
      "id": "no-user",
      "description": "Une identité absente est rejetée avant toute décision.",
      "input": {
        "organizationId": "organization-a",
        "uid": "",
        "membership": null,
        "legacyAccess": null,
        "platformAdministrator": false
      },
      "expectedError": "invalid_identity"
    },
    {
      "id": "membership-absent",
      "description": "Sans membership ni privilège global, aucun accès organisationnel n'est accordé.",
