rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function currentRole() {
      return get(rolePath()).data;
    }

    function hasOnlyStringLocationIds(values) {
      return values is list
        && values.size() <= 65
        && (values.size() == 0
          || values.join('\u001f').split('\u001f') == values)
        && !('' in values)
        && !('\u001f' in values);
    }

    function hasNoBlankLocationIds(values) {
      return !values
        .join('\u001f')
        .matches('(^|.*\u001f)[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*(\u001f.*|$)');
    }

    function isNonBlankCanonicalText(value) {
      return value is string && hasNoBlankLocationIds([value]);
    }

    function isValidAdminInvitationEmail(value) {
      return value is string
        && value.matches('^[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*[^\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]{1,255}[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$')
        && value.matches('^[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*[^@\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+@[^@\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+\\.[^@\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*$');
    }

    function validLocationIds(values) {
      return hasOnlyStringLocationIds(values)
        && hasNoBlankLocationIds(values)
        && !('*' in values)
        && values.toSet().size() == values.size()
        && values.size() > 0;
    }

    function hasValidInvitationScope(invitation) {
      return 'locationIds' in invitation
        && (
          (invitation.role == 'site_manager'
            && validLocationIds(invitation.locationIds))
          || (invitation.role == 'coordinator'
            && invitation.locationIds == [])
        );
    }

    function isLegacyRoleDocument(role) {
      return !('roles' in role)
        && !('schemaVersion' in role)
        && role.active is bool
        && role.role in ['coordinator', 'site_manager']
        && (
          (role.role == 'coordinator'
            && (!('locationIds' in role)
              || (role.locationIds is list
                && (role.locationIds == [] || role.locationIds == ['*']))))
          || (role.role == 'site_manager'
            && 'locationIds' in role
            && validLocationIds(role.locationIds))
        );
    }

    function isV2RoleDocument(role) {
      let validRoles = role.roles is list
        && (role.roles == ['coordinator']
          || role.roles == ['site_manager']
          || role.roles == ['coordinator', 'site_manager']);
      let containsSiteManager = validRoles
        && 'site_manager' in role.roles;
      return 'roles' in role
        && 'schemaVersion' in role
        && role.schemaVersion is int
        && role.schemaVersion == 2
        && role.active is bool
        && validRoles
        && role.role == (('coordinator' in role.roles)
          ? 'coordinator'
          : 'site_manager')
        && (containsSiteManager
          ? validLocationIds(role.locationIds)
          : role.locationIds == []);
    }

    function isValidRoleDocument(role) {
      return 'roles' in role
        ? isV2RoleDocument(role)
        : isLegacyRoleDocument(role);
    }

    function hasRole(role, roleName) {
      return 'roles' in role
        ? roleName in role.roles
        : role.role == roleName;
    }

    function hasActiveRole() {
      return isSignedIn()
        && exists(rolePath())
        && isValidRoleDocument(currentRole())
        && currentRole().active == true;
    }

    function isCoordinator() {
      return hasActiveRole()
        && hasRole(currentRole(), 'coordinator');
    }

    function isActiveSiteManager() {
      return hasActiveRole()
        && hasRole(currentRole(), 'site_manager');
    }

    function canManageLocation(locationId) {
      return hasActiveRole()
        && (
          hasRole(currentRole(), 'coordinator')
          || (hasRole(currentRole(), 'site_manager')
            && locationId in currentRole().locationIds)
        );
    }

    function isVolunteerOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function canGetOwnEngagement(engagementId) {
      let path = /databases/$(database)/documents/engagements/$(engagementId);
      return isSignedIn()
        && engagementId.matches('^.+_' + request.auth.uid + '$')
        && (!exists(path)
          || resource.data.volunteerId == request.auth.uid);
    }

    function validProfession(value) {
      return value in [
        'physiotherapist', 'podiatrist', 'physician', 'nurse',
        'veterinarian', 'other_health_professional', 'mk', 'pp', 'doctor',
        'otherHealthProfessional'
      ];
    }

    function validProfileProfession(value) {
      return validProfession(value);
    }

    function canonicalProfession(value) {
      return value == 'mk' || value == 'physiotherapist'
        ? 'physiotherapist'
        : (value == 'pp' || value == 'podiatrist'
          ? 'podiatrist'
          : (value == 'doctor' || value == 'physician'
            ? 'physician'
            : (value == 'nurse'
              ? 'nurse'
              : (value == 'veterinarian'
                ? 'veterinarian'
                : (value == 'otherHealthProfessional'
                      || value == 'other_health_professional'
                  ? 'other_health_professional'
                  : 'invalid')))));
    }

    function validQuotaMap(value) {
      return value is map
        && value.keys().hasOnly([
          'physiotherapist', 'podiatrist', 'physician', 'nurse',
          'veterinarian', 'other_health_professional'
        ])
        && value.get('physiotherapist', 0) is int
        && value.get('podiatrist', 0) is int
        && value.get('physician', 0) is int
        && value.get('nurse', 0) is int
        && value.get('veterinarian', 0) is int
        && value.get('other_health_professional', 0) is int
        && value.get('physiotherapist', 0) >= 0
        && value.get('podiatrist', 0) >= 0
        && value.get('physician', 0) >= 0
        && value.get('nurse', 0) >= 0
        && value.get('veterinarian', 0) >= 0
        && value.get('other_health_professional', 0) >= 0;
    }

    function hasGenericQuotas(data) {
      return 'requiredByProfession' in data
        || 'registeredByProfession' in data;
    }

    function requiredQuota(data, profession) {
      return 'requiredByProfession' in data
        ? data.requiredByProfession.get(profession, 0)
        : (profession == 'physiotherapist'
          ? data.requiredMk
          : (profession == 'podiatrist' ? data.requiredPp : 0));
    }

    function registeredQuota(data, profession) {
      return 'registeredByProfession' in data
        ? data.registeredByProfession.get(profession, 0)
        : (profession == 'physiotherapist'
          ? data.registeredMk
          : (profession == 'podiatrist' ? data.registeredPp : 0));
    }

    function validGenericQuotaData(data) {
      return !hasGenericQuotas(data)
        ? (data.registeredMk is int
          && data.registeredPp is int
          && data.registeredMk >= 0
          && data.registeredPp >= 0
          && data.registeredMk <= data.requiredMk
          && data.registeredPp <= data.requiredPp)
        : ('requiredByProfession' in data
          && 'registeredByProfession' in data
          && validQuotaMap(data.requiredByProfession)
          && validQuotaMap(data.registeredByProfession)
          && validGenericQuotaValues(data));
    }

    function validGenericQuotaValues(data) {
      return data.registeredByProfession.get('physiotherapist', 0)
          <= data.requiredByProfession.get('physiotherapist', 0)
        && data.registeredByProfession.get('podiatrist', 0)
          <= data.requiredByProfession.get('podiatrist', 0)
        && data.registeredByProfession.get('physician', 0)
          <= data.requiredByProfession.get('physician', 0)
        && data.registeredByProfession.get('nurse', 0)
          <= data.requiredByProfession.get('nurse', 0)
        && data.registeredByProfession.get('veterinarian', 0)
          <= data.requiredByProfession.get('veterinarian', 0)
        && data.registeredByProfession.get('other_health_professional', 0)
          <= data.requiredByProfession.get('other_health_professional', 0)
        && data.requiredMk
          == data.requiredByProfession.get('physiotherapist', 0)
        && data.requiredPp
          == data.requiredByProfession.get('podiatrist', 0)
        && data.registeredMk
          == data.registeredByProfession.get('physiotherapist', 0)
        && data.registeredPp
          == data.registeredByProfession.get('podiatrist', 0);
    }

    function validCounterQuotaData(before, after) {
      return !hasGenericQuotas(after)
        ? (sameRequiredQuotas(before, after)
          && validGenericQuotaData(after))
        : ('requiredByProfession' in after
          && 'registeredByProfession' in after
          && sameRequiredQuotas(before, after)
          && validQuotaMap(after.registeredByProfession)
          && validGenericQuotaValues(after));
    }

    function validEngagementCounterData(before, after, professionValue) {
      let profession = canonicalProfession(professionValue);
      return 'requiredByProfession' in before
        ? ('requiredByProfession' in after
          && 'registeredByProfession' in after
          && after.requiredByProfession
            .diff(before.requiredByProfession)
            .affectedKeys()
            .size() == 0
          && after.requiredMk == before.requiredMk
          && after.requiredPp == before.requiredPp
          && after.registeredByProfession.get(profession, -1) is int
          && after.registeredByProfession.get(profession, -1) >= 0
          && after.registeredByProfession.get(profession, -1)
            <= after.requiredByProfession.get(profession, 0)
          && (profession == 'physiotherapist'
            ? (after.registeredMk
                == after.registeredByProfession.get('physiotherapist', 0)
              && after.registeredPp == before.registeredPp)
            : (profession == 'podiatrist'
              ? (after.registeredPp
                  == after.registeredByProfession.get('podiatrist', 0)
                && after.registeredMk == before.registeredMk)
              : (after.registeredMk == before.registeredMk
                && after.registeredPp == before.registeredPp))))
        : validCounterQuotaData(before, after);
    }

    function totalRequired(data) {
      return 'requiredByProfession' in data
        ? data.requiredByProfession.get('physiotherapist', 0)
          + data.requiredByProfession.get('podiatrist', 0)
          + data.requiredByProfession.get('physician', 0)
          + data.requiredByProfession.get('nurse', 0)
          + data.requiredByProfession.get('veterinarian', 0)
          + data.requiredByProfession.get('other_health_professional', 0)
        : data.requiredMk + data.requiredPp;
    }

    function totalRegistered(data) {
      return 'registeredByProfession' in data
        ? data.registeredByProfession.get('physiotherapist', 0)
          + data.registeredByProfession.get('podiatrist', 0)
          + data.registeredByProfession.get('physician', 0)
          + data.registeredByProfession.get('nurse', 0)
          + data.registeredByProfession.get('veterinarian', 0)
          + data.registeredByProfession.get('other_health_professional', 0)
        : data.registeredMk + data.registeredPp;
    }

    function validRegisteredDelta(before, after, professionValue, delta) {
      let profession = canonicalProfession(professionValue);
      return profession != 'invalid'
        && registeredQuota(after, profession)
          == registeredQuota(before, profession) + delta
        && (!('registeredByProfession' in before)
          ? ((profession == 'physiotherapist'
              && after.registeredPp == before.registeredPp)
            || (profession == 'podiatrist'
              && after.registeredMk == before.registeredMk)
            || (profession != 'physiotherapist'
              && profession != 'podiatrist'))
          : (('registeredByProfession' in after)
            && after.registeredByProfession
              .diff(before.registeredByProfession)
              .affectedKeys()
              .hasOnly([profession])));
    }

    function sameRequiredQuotas(before, after) {
      return after.requiredMk == before.requiredMk
        && after.requiredPp == before.requiredPp
        && (!('requiredByProfession' in before)
          ? (!('requiredByProfession' in after)
            || (after.requiredByProfession.get('physician', 0) == 0
              && after.requiredByProfession.get('nurse', 0) == 0
              && after.requiredByProfession.get('veterinarian', 0) == 0
              && after.requiredByProfession
                .get('other_health_professional', 0) == 0))
          : ('requiredByProfession' in after
            && after.requiredByProfession == before.requiredByProfession));
    }

    function exactlyOneRegisteredDelta(before, after) {
      let delta = totalRegistered(after) - totalRegistered(before);
      return (delta == 1 || delta == -1)
        && (
          ('registeredByProfession' in before
            && 'registeredByProfession' in after
            && after.registeredByProfession
              .diff(before.registeredByProfession)
              .affectedKeys()
              .size() == 1)
          || (!('registeredByProfession' in before)
            && ((after.registeredMk
                == before.registeredMk + delta
                && after.registeredPp == before.registeredPp)
              || (after.registeredPp
                == before.registeredPp + delta
                && after.registeredMk == before.registeredMk)))
        );
    }

    function validEngagementStatus(value) {
      return value == 'pending'
        || value == 'confirmed'
        || value == 'standby'
        || value == 'cancelled';
    }

    function validProfessionalIdentity(data) {
      let hasType = 'professionalIdType' in data;
      let hasValue = 'professionalIdValue' in data;
      return !hasType && !hasValue
        ? ('rpps' in data
          && data.rpps is string
          && data.rpps.matches('^[0-9]{11}$'))
        : (hasType
          && hasValue
          && data.professionalIdType in ['rpps', 'ordinal', 'none']
          && data.professionalIdValue is string
          && (data.professionalIdType == 'rpps'
            ? (data.professionalIdValue.matches('^[0-9]{11}$')
              && 'rpps' in data
              && data.rpps == data.professionalIdValue)
            : (data.professionalIdType == 'ordinal'
              ? (data.professionalIdValue.size() > 0
                && !('rpps' in data))
              : (data.professionalIdValue == ''
                && !('rpps' in data)))));
    }

    function validOptionalCpts(data) {
      let cptsId = data.get('cptsId', '');
      let cptsLabel = data.get('cptsLabel', '');
      return cptsId is string
        && cptsLabel is string
        && cptsId.size() <= 160
        && cptsLabel.size() <= 160;
    }

    function validProfessionalAddress(data) {
      let addressKeys = [
        'professionalAddressLine1', 'professionalAddressLine2',
        'professionalPostalCode', 'professionalCity',
        'professionalCountryCode'
      ];
      let line1 = data.get('professionalAddressLine1', '');
      let line2 = data.get('professionalAddressLine2', '');
      let postalCode = data.get('professionalPostalCode', '');
      let city = data.get('professionalCity', '');
      let countryCode = data.get('professionalCountryCode', 'FR');
      let hasAddress = line1 != ''
        || line2 != ''
        || postalCode != ''
        || city != '';
      return !data.keys().hasAny(addressKeys)
        || (line1 is string
          && line2 is string
          && postalCode is string
          && city is string
          && countryCode is string
          && line1.size() <= 240
          && line2.size() <= 240
          && postalCode.size() <= 16
          && city.size() <= 120
          && countryCode.matches('^[A-Z]{2}$')
          && (!hasAddress
            || (isNonBlankCanonicalText(line1)
              && isNonBlankCanonicalText(city)
              && (countryCode == 'FR'
                ? postalCode.matches('^[0-9]{5}$')
                : postalCode.matches(
                  '^[A-Za-z0-9][A-Za-z0-9 -]{1,15}$'
                )))));
    }

    function validOptionalEquipmentDetails(data) {
      let details = data.get('otherEquipmentDetails', '');
      let customizableEquipment = [
        'other_equipment',
        'profession_specific_equipment',
        'other_veterinary_equipment'
      ];
      return details is string
        && (!data.equipment.hasAny(customizableEquipment)
          || isNonBlankCanonicalText(details));
    }

    function validOptionalProfileSchemaVersion(data) {
      let version = data.get('profileSchemaVersion', 1);
      return version is int && version >= 1;
    }

    function validOpenPreferenceList(block, key) {
      let values = block.get(key, []);
      return values is list;
    }

    function validOptionalCompetencies(data) {
      let block = data.get('competencies', {});
      let details = block.get('otherSkillDetails', '');
      let taxonomyVersion = block.get('taxonomyVersion', 1);
      return !('competencies' in data)
        || (block is map
          && block.keys().hasOnly([
            'skillIds', 'otherSkillDetails', 'taxonomyVersion'
          ])
          && validOpenPreferenceList(block, 'skillIds')
          && details is string
          && taxonomyVersion is int
          && taxonomyVersion >= 1);
    }

    function validOptionalMobilizationPreferences(data) {
      let block = data.get('mobilizationPreferences', {});
      let weekdays = block.get('preferredWeekdays', []);
      let schemaVersion = block.get('schemaVersion', 1);
      return !('mobilizationPreferences' in data)
        || (block is map
          && block.keys().hasOnly([
            'preferredMobilizationTypes', 'territoryIds', 'locationIds',
            'preferredWeekdays', 'preferredTimeBands', 'schemaVersion'
          ])
          && validOpenPreferenceList(block, 'preferredMobilizationTypes')
          && validOpenPreferenceList(block, 'territoryIds')
          && validOpenPreferenceList(block, 'locationIds')
          && weekdays is list
          && weekdays.size() <= 7
          && weekdays.toSet().hasOnly([
            'monday', 'tuesday', 'wednesday', 'thursday', 'friday',
            'saturday', 'sunday'
          ])
          && validOpenPreferenceList(block, 'preferredTimeBands')
          && schemaVersion is int
          && schemaVersion >= 1);
    }

    function validOptionalCommunicationPreferences(data) {
      let block = data.get('communicationPreferences', {});
      let hasQuietStart = 'quietHoursStart' in block;
      let hasQuietEnd = 'quietHoursEnd' in block;
      let quietStart = block.get('quietHoursStart', 0);
      let quietEnd = block.get('quietHoursEnd', 0);
      let schemaVersion = block.get('schemaVersion', 1);
      let channelValues = [
        block.get('push', false), block.get('email', false),
        block.get('sms', false), block.get('compatibleMissions', false),
        block.get('engagementUpdates', false),
        block.get('operationalAlerts', false)
      ];
      return !('communicationPreferences' in data)
        || (block is map
          && block.keys().hasOnly([
            'push', 'email', 'sms', 'compatibleMissions',
            'engagementUpdates', 'operationalAlerts', 'quietHoursStart',
            'quietHoursEnd', 'schemaVersion'
          ])
          && channelValues.toSet().hasOnly([true, false])
          && hasQuietStart == hasQuietEnd
          && (!hasQuietStart
            || (quietStart is int
              && quietStart >= 0
              && quietStart <= 23
              && quietEnd is int
              && quietEnd >= 0
              && quietEnd <= 23))
          && schemaVersion is int
          && schemaVersion >= 1);
    }

    function validProfessionalConsentRecord(record) {
      return record is map
        && record.keys().hasOnly([
          'type', 'version', 'state', 'recordedAt', 'source'
        ])
        && record.get('type', '').matches(
          '^[a-z0-9][a-z0-9._-]{0,79}$'
        )
        && record.get('version', '').matches('^.{1,80}$')
        && record.get('state', '').matches(
          '^[a-z0-9][a-z0-9._-]{0,79}$'
        )
        && record.recordedAt is timestamp
        && record.get('source', '').matches(
          '^[a-z0-9][a-z0-9._-]{0,79}$'
        );
    }

    function validProfessionalConsentRecords(records) {
      return records is list
        && records.size() <= 5
        && (records.size() < 1 || validProfessionalConsentRecord(records[0]))
        && (records.size() < 2 || validProfessionalConsentRecord(records[1]))
        && (records.size() < 3 || validProfessionalConsentRecord(records[2]))
        && (records.size() < 4 || validProfessionalConsentRecord(records[3]))
        && (records.size() < 5 || validProfessionalConsentRecord(records[4]));
    }

    function validOptionalProfessionalConsentRecords(data) {
      return !('consentRecords' in data)
        || validProfessionalConsentRecords(data.consentRecords);
    }

    function hasNoVerifiedIdentityFields(data) {
      return !('verificationSource' in data)
        && !('verifiedFirstName' in data)
        && !('verifiedLastName' in data)
        && !('verifiedProfessionCode' in data)
        && !('verifiedProfessionLabel' in data)
        && !('verifiedAt' in data);
    }

    function isUnverifiedProfile(data) {
      return (!('verificationStatus' in data)
          || data.verificationStatus == 'unverified')
        && hasNoVerifiedIdentityFields(data);
    }

    function expectedRppsProfessionCode(profession) {
      let canonical = canonicalProfession(profession);
      return canonical == 'physician'
        ? '10'
        : (canonical == 'nurse'
          ? '60'
          : (canonical == 'physiotherapist'
            ? '70'
            : (canonical == 'podiatrist' ? '80' : 'unsupported')));
    }

    function isCompleteVerifiedProfile(data) {
      return data.get('verificationStatus', '') == 'verified'
        && data.get('verificationSource', '') == 'ans_rpps'
        && data.get('professionalIdType', '') == 'rpps'
        && data.get('professionalIdValue', '').matches('^[0-9]{11}$')
        && data.get('rpps', '') == data.professionalIdValue
        && isNonBlankCanonicalText(data.get('verifiedFirstName', ''))
        && isNonBlankCanonicalText(data.get('verifiedLastName', ''))
        && data.get('verifiedProfessionCode', '')
          == expectedRppsProfessionCode(data.profession)
        && isNonBlankCanonicalText(data.get('verifiedProfessionLabel', ''))
        && data.get('verifiedAt', null) is timestamp;
    }

    function validVerificationData(data) {
      return isUnverifiedProfile(data) || isCompleteVerifiedProfile(data);
    }

    function clientVerificationUpdateIsSafe() {
      let professionalIdentityChanged = request.resource.data.profession
          != resource.data.profession
        || request.resource.data.get('professionalIdType', '')
          != resource.data.get('professionalIdType', '')
        || request.resource.data.get('professionalIdValue', '')
          != resource.data.get('professionalIdValue', '');
      let verifiedFields = [
        'verificationStatus', 'verificationSource', 'verifiedFirstName',
        'verifiedLastName', 'verifiedProfessionCode',
        'verifiedProfessionLabel', 'verifiedAt'
      ];
      return (isUnverifiedProfile(request.resource.data)
          && (isUnverifiedProfile(resource.data) || professionalIdentityChanged))
        || (isCompleteVerifiedProfile(request.resource.data)
          && isCompleteVerifiedProfile(resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(verifiedFields)
          && !professionalIdentityChanged);
    }

    function validVolunteerData(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'profession', 'firstName', 'lastName', 'phone', 'email',
          'rpps', 'professionalIdType', 'professionalIdValue',
          'cptsId', 'cptsLabel', 'equipment', 'otherEquipmentDetails',
          'professionalAddressLine1', 'professionalAddressLine2',
          'professionalPostalCode', 'professionalCity',
          'professionalCountryCode',
          'verificationStatus', 'verificationSource', 'verifiedFirstName',
          'verifiedLastName', 'verifiedProfessionCode',
          'verifiedProfessionLabel', 'verifiedAt',
          'profileSchemaVersion', 'competencies',
          'mobilizationPreferences', 'communicationPreferences',
          'consentRecords',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'profession', 'firstName', 'lastName', 'phone', 'email',
          'equipment', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && validProfileProfession(request.resource.data.profession)
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.equipment is list
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && validProfessionalIdentity(request.resource.data)
        && validOptionalCpts(request.resource.data)
        && validProfessionalAddress(request.resource.data)
        && validOptionalEquipmentDetails(request.resource.data)
        && validOptionalProfileSchemaVersion(request.resource.data)
        && validOptionalCompetencies(request.resource.data)
        && validOptionalMobilizationPreferences(request.resource.data)
        && validOptionalCommunicationPreferences(request.resource.data)
        && validOptionalProfessionalConsentRecords(request.resource.data);
    }

    function platformAdministratorPath(uid) {
      return /databases/$(database)/documents/platformAdministrators/$(uid);
    }

    function isPlatformAdministrator() {
      return isSignedIn()
        && exists(platformAdministratorPath(request.auth.uid))
        && get(platformAdministratorPath(request.auth.uid)).data.active == true;
    }

    function organizationMembershipPath(organizationId, uid) {
      return /databases/$(database)/documents/organizationMemberships/$(organizationId + '_' + uid);
    }

    function isCanonicalOrganizationMembership(membershipId, membership) {
      let organizationId = membership.get('organizationId', '');
      let uid = membership.get('uid', '');
      return organizationId is string
        && uid is string
        && membershipId == organizationId + '_' + uid;
    }

    function hasValidOrganizationRoles(roles) {
      return roles is list
        && roles.size() > 0
        && roles.size() <= 4
        && roles.toSet().size() == roles.size()
        && roles.toSet().hasOnly([
          'organization_admin', 'coordinator', 'site_manager', 'professional'
        ]);
    }

    function hasValidOrganizationLocationIds(locationIds) {
      return locationIds == []
        || (hasOnlyStringLocationIds(locationIds)
          && hasNoBlankLocationIds(locationIds)
          && !('*' in locationIds)
          && locationIds.toSet().size() == locationIds.size());
    }

    function hasValidOrganizationRoleScope(roles, locationIds) {
      return ('site_manager' in roles)
        ? locationIds.size() > 0
        : locationIds == [];
    }

    function isValidOrganizationMembershipFor(
      organizationId,
      uid,
      membership
    ) {
      return membership.get('organizationId', '') == organizationId
        && membership.get('uid', '') == uid
        && membership.get('active', null) is bool
        && hasValidOrganizationRoles(membership.get('roles', []))
        && hasValidOrganizationLocationIds(
          membership.get('locationIds', [])
        )
        && hasValidOrganizationRoleScope(
          membership.get('roles', []),
          membership.get('locationIds', [])
        )
        && membership.get('schemaVersion', 0) is int
        && membership.get('schemaVersion', 0) >= 1;
    }

    function hasOrganizationMembershipDocument(organizationId) {
      return isSignedIn()
        && exists(organizationMembershipPath(
          organizationId,
          request.auth.uid
        ));
    }

    function hasActiveOrganizationMembership(organizationId) {
      let membershipPath = organizationMembershipPath(
        organizationId,
        request.auth.uid
      );
      let membership = isSignedIn() && exists(membershipPath)
        ? get(membershipPath).data
        : {};
      return isSignedIn()
        && exists(membershipPath)
        && isValidOrganizationMembershipFor(
          organizationId,
          request.auth.uid,
          membership
        )
        && membership.get('active', false) == true;
    }

    function hasOrganizationRole(organizationId, roleName) {
      let membershipPath = organizationMembershipPath(
        organizationId,
        request.auth.uid
      );
      return hasActiveOrganizationMembership(organizationId)
        && roleName in get(membershipPath).data.roles;
    }

    function organizationMembershipLocationIds(organizationId) {
      return get(organizationMembershipPath(
        organizationId,
        request.auth.uid
      )).data.locationIds;
    }

    function hasLegacyOrganizationRole(organizationId, roleName) {
      return organizationId == legacyOrganizationId()
        && !hasOrganizationMembershipDocument(organizationId)
        && hasActiveRole()
        && hasRole(currentRole(), roleName);
    }

    function isOrganizationAdmin(organizationId) {
      return hasOrganizationRole(organizationId, 'organization_admin');
    }

    function isOrganizationCoordinator(organizationId) {
      return hasOrganizationRole(organizationId, 'coordinator')
        || hasLegacyOrganizationRole(organizationId, 'coordinator');
    }

    function isOrganizationSiteManager(organizationId) {
      return hasOrganizationRole(organizationId, 'site_manager')
        || hasLegacyOrganizationRole(organizationId, 'site_manager');
    }

    function isOrganizationProfessional(organizationId) {
      return hasOrganizationRole(organizationId, 'professional');
    }

    function canOrganizationSiteManagerAccessLocation(
      organizationId,
      locationId
    ) {
      return (hasOrganizationRole(organizationId, 'site_manager')
          && locationId in organizationMembershipLocationIds(organizationId))
        || (hasLegacyOrganizationRole(organizationId, 'site_manager')
          && locationId in currentRole().locationIds);
    }

    function hasActiveCanonicalMembershipDocument(organizationId) {
      return hasActiveOrganizationMembership(organizationId);
    }

    function legacyOrganizationId() {
      return 'legacy-gironde';
    }

    function operationPath(operationId) {
      return /databases/$(database)/documents/operations/$(operationId);
    }

    function missionPath(missionId) {
      return /databases/$(database)/documents/missions/$(missionId);
    }

    function operationOwnerOrganizationId(operation) {
      return operation.get('ownerOrganizationId', legacyOrganizationId());
    }

    function hasValidOperationOrganization(operation) {
      return isNonBlankCanonicalText(
        operationOwnerOrganizationId(operation)
      );
    }

    function isPublishedOperation(operation) {
      return operation.get('status', '') in [
        'planned', 'active', 'suspended', 'completed'
      ];
    }

    // Une lecture documentaire conserve le legacy Gironde sans visibilité.
    // Une requête de collection doit en revanche porter `visibility` afin que
    // les Rules puissent prouver le bornage sans inspecter après lecture.
    function isPlatformDiscoverableOperation(operation) {
      return hasValidOperationOrganization(operation)
        && isPublishedOperation(operation)
        && (operation.get('visibility', '__missing__') == 'platform'
          || (!('visibility' in operation)
            && operationOwnerOrganizationId(operation)
              == legacyOrganizationId()));
    }

    function isExplicitPlatformDiscoverableOperation(operation) {
      return hasValidOperationOrganization(operation)
        && operation.get('visibility', '__missing__') == 'platform'
        && isPublishedOperation(operation);
    }

    function canAccessOrganization(organizationId) {
      return isPlatformAdministrator()
        || hasActiveOrganizationMembership(organizationId)
        || isOrganizationCoordinator(organizationId)
        || isOrganizationSiteManager(organizationId);
    }

    function locationManagingOrganizationId(location) {
      return location.get('managingOrganizationId', legacyOrganizationId());
    }

    function hasValidLocationOrganization(location) {
      return isNonBlankCanonicalText(
        locationManagingOrganizationId(location)
      );
    }

    function isLegacyPublicLocation(location) {
      return hasValidLocationOrganization(location)
        && locationManagingOrganizationId(location) == legacyOrganizationId();
    }

    function canReadPrivilegedLocation(locationId, location) {
      let organizationId = locationManagingOrganizationId(location);
      return hasValidLocationOrganization(location)
        && (isPlatformAdministrator()
          || isOrganizationAdmin(organizationId)
          || isOrganizationCoordinator(organizationId)
          || canOrganizationSiteManagerAccessLocation(
            organizationId,
            locationId
          ));
    }

    function canReadOperationOrganization(operation) {
      let organizationId = operationOwnerOrganizationId(operation);
      return hasValidOperationOrganization(operation)
        && canAccessOrganization(organizationId);
    }

    function hasOperationOrganizationMembership(operation) {
      let organizationId = operationOwnerOrganizationId(operation);
      return hasValidOperationOrganization(operation)
        && hasActiveOrganizationMembership(organizationId);
    }

    function canReadOperationById(operationId) {
      let path = operationPath(operationId);
      return operationId is string
        && isNonBlankCanonicalText(operationId)
        && exists(path)
        && canReadOperationOrganization(get(path).data);
    }

    function canReadOwnOrganizationMembership(membershipId) {
      return isSignedIn()
        && isCanonicalOrganizationMembership(membershipId, resource.data)
        && resource.data.get('uid', '') == request.auth.uid;
    }

    function canOrganizationAdminReadMembership(membershipId) {
      let organizationId = resource.data.get('organizationId', '');
      return isCanonicalOrganizationMembership(membershipId, resource.data)
        && isOrganizationAdmin(organizationId);
    }

    function canOrganizationAdminListMembership() {
      let organizationId = resource.data.get('organizationId', '');
      return isNonBlankCanonicalText(organizationId)
        && isOrganizationAdmin(organizationId);
    }

    function canUseProfessionalOwnerWritePath() {
      return isSignedIn() && !isPlatformAdministrator();
    }

    function mobilizationPath(mobilizationId) {
      return /databases/$(database)/documents/mobilizations/$(mobilizationId);
    }

    function hasValidMobilizationOperation(mobilization) {
      return 'operationId' in mobilization
        && isNonBlankCanonicalText(mobilization.operationId);
    }

    function isLegacyMobilization(mobilization) {
      return !('operationId' in mobilization);
    }

    function isConfiguredLegacyMobilization(mobilizationId, mobilization) {
      let configPath = /databases/$(database)/documents/platform/config;
      return isLegacyMobilization(mobilization)
        && exists(configPath)
        && get(configPath).data.get('activeMobilizationId', '')
          == mobilizationId;
    }

    function isPlatformDiscoverableMobilization(
      mobilizationId,
      mobilization
    ) {
      let operationId = mobilization.get('operationId', '__missing__');
      let path = operationPath(operationId);
      return isConfiguredLegacyMobilization(mobilizationId, mobilization)
        || (hasValidMobilizationOperation(mobilization)
          && exists(path)
          && isPlatformDiscoverableOperation(get(path).data));
    }

    function isExplicitPlatformDiscoverableMobilization(mobilization) {
      let operationId = mobilization.get('operationId', '__missing__');
      let path = operationPath(operationId);
      return hasValidMobilizationOperation(mobilization)
        && exists(path)
        && isExplicitPlatformDiscoverableOperation(get(path).data);
    }

    function isPlatformDiscoverableMobilizationById(mobilizationId) {
      let path = mobilizationPath(mobilizationId);
      return mobilizationId is string
        && isNonBlankCanonicalText(mobilizationId)
        && exists(path)
        && isPlatformDiscoverableMobilization(
          mobilizationId,
          get(path).data
        );
    }

    function canReadMobilizationOrganization(mobilization) {
      let operationId = mobilization.get('operationId', '__missing__');
      let path = operationPath(operationId);
      let operation = hasValidMobilizationOperation(mobilization)
        && exists(path)
        ? get(path).data
        : {};
      return isLegacyMobilization(mobilization)
        || (hasValidMobilizationOperation(mobilization)
          && exists(path)
          && (!('ownerOrganizationId' in operation)
            || canReadOperationOrganization(operation)));
    }

    function hasMobilizationOrganizationMembership(mobilization) {
      let operationId = mobilization.get('operationId', '__missing__');
      let operation = hasValidMobilizationOperation(mobilization)
        && exists(operationPath(operationId))
        ? get(operationPath(operationId)).data
        : {};
      return (hasValidMobilizationOperation(mobilization)
          && exists(operationPath(operationId))
          && hasOperationOrganizationMembership(operation))
        || (isLegacyMobilization(mobilization)
          && hasActiveOrganizationMembership(legacyOrganizationId()));
    }

    function canReadMobilizationById(mobilizationId) {
      let path = mobilizationPath(mobilizationId);
      return mobilizationId is string
        && isNonBlankCanonicalText(mobilizationId)
        && exists(path)
        && canReadMobilizationOrganization(get(path).data);
    }

    function canReadOrganizationMissionScope(mobilizationId, locationId) {
      let currentMobilizationPath = mobilizationPath(mobilizationId);
      let mobilization = exists(currentMobilizationPath)
        ? get(currentMobilizationPath).data
        : {};
      let operationId = mobilization.get('operationId', '__missing__');
      let currentOperationPath = operationPath(operationId);
      let operation = hasValidMobilizationOperation(mobilization)
          && exists(currentOperationPath)
        ? get(currentOperationPath).data
        : {};
      let organizationId = isLegacyMobilization(mobilization)
        ? legacyOrganizationId()
        : operationOwnerOrganizationId(operation);
      return exists(currentMobilizationPath)
        && (isLegacyMobilization(mobilization)
          || (hasValidMobilizationOperation(mobilization)
            && exists(currentOperationPath)
            && hasValidOperationOrganization(operation)))
        && canOrganizationRoleReadMission(organizationId, locationId);
    }

    // Chemin d'autorisation compact pour rester sous la limite d'expressions
    // Firestore lors d'une lecture Engagement (mission + mobilisation + rôle).
    // Les memberships sont écrites exclusivement par backend privilégié.
    function canOrganizationRoleReadMission(organizationId, locationId) {
      let membershipPath = organizationMembershipPath(
        organizationId,
        request.auth.uid
      );
      let membership = isSignedIn() && exists(membershipPath)
        ? get(membershipPath).data
        : {};
      let roles = membership.get('roles', []);
      let locationIds = membership.get('locationIds', []);
      return (isSignedIn()
          && exists(membershipPath)
          && membership.get('organizationId', '') == organizationId
          && membership.get('uid', '') == request.auth.uid
          && membership.get('active', false) == true
          && roles is list
          && roles.size() > 0
          && roles.size() <= 4
          && roles.toSet().hasOnly([
            'organization_admin', 'coordinator', 'site_manager', 'professional'
          ])
          && locationIds is list
          && membership.get('schemaVersion', 0) is int
          && membership.get('schemaVersion', 0) >= 1
          && (('site_manager' in roles && locationIds.size() > 0)
            || (!('site_manager' in roles) && locationIds == []))
          && ('coordinator' in roles
            || ('site_manager' in roles
              && locationIds.size() > 0
              && locationId in locationIds)));
    }

    function isLegacyMobilizationById(mobilizationId) {
      let path = mobilizationPath(mobilizationId);
      return exists(path) && isLegacyMobilization(get(path).data);
    }

    function canUseExplicitMobilizationOrganizationAsRole(mobilizationId) {
      let mobilization = get(mobilizationPath(mobilizationId)).data;
      let operationId = mobilization.get('operationId', '__missing__');
      let operation = get(operationPath(operationId)).data;
      return hasValidMobilizationOperation(mobilization)
        && (!('ownerOrganizationId' in operation)
          || hasActiveCanonicalMembershipDocument(
            operation.ownerOrganizationId
          ));
    }

    function canUseMobilizationOrganizationAsRole(mobilizationId) {
      return (isLegacyMobilizationById(mobilizationId)
          && !hasOrganizationMembershipDocument(legacyOrganizationId()))
        || canUseExplicitMobilizationOrganizationAsRole(mobilizationId);
    }

    function canReadMissionOrganization(mission) {
      return 'mobilizationId' in mission
        && canReadMobilizationById(mission.mobilizationId);
    }

    function canReadEngagementOrganization(engagement) {
      let missionId = engagement.get('missionId', '__missing__');
      let path = missionPath(missionId);
      return missionId is string
        && isNonBlankCanonicalText(missionId)
        && exists(path)
        && get(path).data.get('mobilizationId', '')
          == engagement.get('mobilizationId', '')
        && canUseMobilizationOrganizationAsRole(
          engagement.get('mobilizationId', '')
        );
    }

    function canReadOrganizationEngagement(engagement) {
      let missionId = engagement.get('missionId', '__missing__');
      let path = missionPath(missionId);
      let mission = exists(path) ? get(path).data : {};
      return exists(path)
        && mission.get('mobilizationId', '')
          == engagement.get('mobilizationId', '')
        && canReadOrganizationMissionScope(
          mission.get('mobilizationId', ''),
          mission.get('locationId', '')
        );
    }

    function platformConfigPath() {
      return /databases/$(database)/documents/platform/config;
    }

    function isActiveMobilization(mobilizationId) {
      return mobilizationId is string
        && exists(mobilizationPath(mobilizationId))
        && get(mobilizationPath(mobilizationId)).data.status == 'active';
    }

    function mobilizationAssignmentPath(mobilizationId, uid) {
      return /databases/$(database)/documents/mobilizationAssignments/$(mobilizationId + '_' + uid);
    }

    function isAssignedOrLegacyCoordinatorForMobilization(mobilizationId) {
      let assignmentPath = mobilizationAssignmentPath(
        mobilizationId,
        request.auth.uid
      );
      let configPath = platformConfigPath();
      return isCoordinator()
        && (
          (exists(assignmentPath)
            && get(assignmentPath).data.uid == request.auth.uid
            && get(assignmentPath).data.mobilizationId == mobilizationId
            && get(assignmentPath).data.role == 'coordinator'
            && get(assignmentPath).data.active == true)
          || ((!('hasActiveMobilizationAssignments' in currentRole())
              || currentRole().hasActiveMobilizationAssignments == false)
            && exists(configPath)
            && get(configPath).data.activeMobilizationId == mobilizationId)
        );
    }

    function canManageMobilizationLocation(mobilizationId, locationId) {
      return (isAssignedOrLegacyCoordinatorForMobilization(mobilizationId)
          || (isActiveSiteManager()
            && locationId in currentRole().locationIds))
        && canUseMobilizationOrganizationAsRole(mobilizationId);
    }

    function canReadMissionScope(mobilizationId, locationId) {
      return canReadOrganizationMissionScope(mobilizationId, locationId)
        || ((isAssignedOrLegacyCoordinatorForMobilization(mobilizationId)
            || (isActiveSiteManager()
              && locationId in currentRole().locationIds))
          && canUseMobilizationOrganizationAsRole(mobilizationId))
        || (!isPlatformAdministrator()
          && !hasActiveRole()
          && isPlatformDiscoverableMobilizationById(mobilizationId));
    }

    function validMissionCreate(missionId) {
      return request.resource.data.keys().hasOnly([
          'id', 'mobilizationId', 'locationId', 'locationName',
          'territorialGroup', 'startAt',
          'endAt', 'requiredMk', 'requiredPp', 'registeredMk', 'registeredPp',
          'requiredByProfession', 'registeredByProfession',
          'requestedEquipment', 'details', 'status', 'createdAt', 'updatedAt',
          'isActive', 'createdBy'
        ])
      && request.resource.data.keys().hasAll([
          'id', 'mobilizationId', 'locationId', 'locationName',
          'territorialGroup', 'startAt',
          'endAt', 'requiredMk', 'requiredPp', 'registeredMk', 'registeredPp',
          'requestedEquipment', 'details', 'status', 'createdAt', 'updatedAt',
          'isActive', 'createdBy'
        ])
        && request.resource.data.id == missionId
        && isActiveMobilization(
          request.resource.data.mobilizationId
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.registeredMk == 0
        && request.resource.data.registeredPp == 0
        && validGenericQuotaData(request.resource.data)
        && totalRegistered(request.resource.data) == 0
        && request.resource.data.requiredMk is int
        && request.resource.data.requiredPp is int
        && request.resource.data.requiredMk >= 0
        && request.resource.data.requiredMk <= 50
        && request.resource.data.requiredPp >= 0
        && request.resource.data.requiredPp <= 50
        && totalRequired(request.resource.data) > 0
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.isActive == true
        && request.resource.data.status == 'critical'
        && exists(/databases/$(database)/documents/locations/$(request.resource.data.locationId))
        && canManageMobilizationLocation(
          request.resource.data.mobilizationId,
          request.resource.data.locationId
        );
    }

    function engagementPath(missionId, uid) {
      return /databases/$(database)/documents/engagements/$(missionId + '_' + uid);
    }

    function volunteerPath(uid) {
      return /databases/$(database)/documents/volunteers/$(uid);
    }

    function hasProfessionalProfile() {
      return isSignedIn()
        && !exists(rolePath())
        && exists(volunteerPath(request.auth.uid));
    }

    function hasParticipationProfessionalIdentifier(data) {
      return 'professionalIdType' in data
        && 'professionalIdValue' in data
        && data.professionalIdType in ['rpps', 'ordinal']
        && isNonBlankCanonicalText(data.professionalIdValue);
    }

    function expectedStatus(data) {
      let required = totalRequired(data);
      let registered = totalRegistered(data);
      return registered == required
        ? 'complete'
        : (registered * 2 < required
          ? 'critical'
          : 'toComplete');
    }

    function validMissionCounterUpdate(missionId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let path = engagementPath(missionId, request.auth.uid);
      let engagementBeforeExists = exists(path);
      let engagementBefore = get(path).data;
      let engagementAfter = getAfter(path).data;
      let beforeStatus = !engagementBeforeExists
        ? 'absent'
        : ('status' in engagementBefore
          ? engagementBefore.status
          : 'confirmed');
      let afterStatus = engagementAfter.status;
      let delta = ((beforeStatus == 'absent'
          || beforeStatus == 'pending'
          || beforeStatus == 'cancelled')
          && afterStatus == 'confirmed')
        ? 1
        : (beforeStatus == 'confirmed' && afterStatus == 'cancelled'
          ? -1
          : 0);
      let profession = delta == 1
        ? engagementAfter.profession
        : engagementBefore.profession;
      return isSignedIn()
        && changed.hasOnly([
          'registeredMk', 'registeredPp', 'registeredByProfession',
          'requiredByProfession', 'status', 'updatedAt'
        ])
        && resource.data.isActive == true
        && isActiveMobilization(resource.data.mobilizationId)
        && resource.data.status != 'cancelled'
        && request.time < resource.data.endAt
        && validEngagementCounterData(
          resource.data, request.resource.data, profession
        )
        && request.resource.data.status == expectedStatus(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && existsAfter(path)
        && engagementAfter.missionId == missionId
        && engagementAfter.mobilizationId == resource.data.mobilizationId
        && engagementAfter.volunteerId == request.auth.uid
        && delta != 0
        && validRegisteredDelta(
          resource.data, request.resource.data, profession, delta
        );
    }

    function validManagedMissionCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAssignedOrLegacyCoordinatorForMobilization(
          resource.data.mobilizationId
        )
        && changed.hasOnly([
          'registeredMk', 'registeredPp', 'registeredByProfession',
          'requiredByProfession', 'status', 'updatedAt'
        ])
        && resource.data.isActive == true
        && isActiveMobilization(resource.data.mobilizationId)
        && resource.data.status != 'cancelled'
        && request.time < resource.data.endAt
        && validCounterQuotaData(resource.data, request.resource.data)
        && request.resource.data.status == expectedStatus(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && exactlyOneRegisteredDelta(resource.data, request.resource.data);
    }

    function validMissionCancellation() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && resource.data.isActive == true
        && isActiveMobilization(resource.data.mobilizationId)
        && canManageMobilizationLocation(
          resource.data.mobilizationId,
          resource.data.locationId
        )
        && resource.data.status != 'cancelled'
        && changed.hasOnly([
          'status', 'isActive', 'cancelledAt', 'cancelledBy',
          'cancellationReason', 'updatedAt'
        ])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.isActive == false
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() <= 300
        && resource.data.createdBy == request.auth.uid;
    }

    function validEngagementCreate(engagementId) {
      let missionId = request.resource.data.missionId;
      let missionBefore = get(
        /databases/$(database)/documents/missions/$(missionId)
      ).data;
      let missionAfter = getAfter(
        /databases/$(database)/documents/missions/$(missionId)
      ).data;
      let profession = request.resource.data.profession;
      return canUseProfessionalOwnerWritePath()
        && request.resource.data.keys().hasOnly([
          'missionId', 'mobilizationId', 'volunteerId', 'profession',
          'createdAt', 'updatedAt', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'missionId', 'mobilizationId', 'volunteerId', 'profession',
          'createdAt', 'updatedAt', 'status'
        ])
        && engagementId == missionId + '_' + request.auth.uid
        && request.resource.data.volunteerId == request.auth.uid
        && request.resource.data.mobilizationId
          == missionBefore.mobilizationId
        && isActiveMobilization(
          request.resource.data.mobilizationId
        )
        && validProfession(profession)
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(volunteerPath(request.auth.uid))
        && getAfter(volunteerPath(request.auth.uid)).data.uid
          == request.auth.uid
        && getAfter(volunteerPath(request.auth.uid)).data.profession
          == profession
        && hasParticipationProfessionalIdentifier(
          getAfter(volunteerPath(request.auth.uid)).data
        )
        && exists(/databases/$(database)/documents/missions/$(missionId))
        && existsAfter(
          /databases/$(database)/documents/missions/$(missionId)
        )
        && missionBefore.isActive == true
        && missionBefore.status != 'cancelled'
        && request.time < missionBefore.endAt
        && missionAfter.updatedAt == request.time;
    }

    function currentEngagementStatus() {
      return 'status' in resource.data
        ? resource.data.status
        : 'confirmed';
    }

    function validCoordinatorTransition(from, to) {
      return (from == 'pending'
          && (to == 'confirmed' || to == 'standby' || to == 'cancelled'))
        || (from == 'confirmed'
          && (to == 'standby' || to == 'cancelled'))
        || (from == 'standby'
          && (to == 'confirmed' || to == 'cancelled'));
    }

    function validEngagementMissionEffect(from, to) {
      let missionPath = /databases/$(database)/documents/missions/$(resource.data.missionId);
      let before = get(missionPath).data;
      let after = getAfter(missionPath).data;
      let profession = resource.data.profession;
      let delta = (from == 'pending' && to == 'confirmed')
          || (from == 'standby' && to == 'confirmed')
          || (from == 'cancelled' && to == 'confirmed')
        ? 1
        : ((from == 'confirmed' && (to == 'standby' || to == 'cancelled'))
          ? -1
          : 0);
      return exists(missionPath)
        && existsAfter(missionPath)
        && resource.data.mobilizationId == before.mobilizationId
        && request.resource.data.mobilizationId == before.mobilizationId
        && isActiveMobilization(before.mobilizationId)
        && before.isActive == true
        && before.status != 'cancelled'
        && request.time < before.endAt
        && (
          (delta == 0
            && validRegisteredDelta(before, after, profession, 0))
          || (delta != 0
            && validRegisteredDelta(before, after, profession, delta))
        );
    }

    function validEngagementStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let from = currentEngagementStatus();
      let to = request.resource.data.status;
      let mission = get(
        /databases/$(database)/documents/missions/$(resource.data.missionId)
      ).data;
      return isAssignedOrLegacyCoordinatorForMobilization(
          resource.data.mobilizationId
        )
        && canReadEngagementOrganization(resource.data)
        && changed.hasOnly(['status', 'updatedAt'])
        && resource.data.mobilizationId == mission.mobilizationId
        && isActiveMobilization(resource.data.mobilizationId)
        && validEngagementStatus(to)
        && request.resource.data.updatedAt == request.time
        && validCoordinatorTransition(from, to)
        && validEngagementMissionEffect(from, to);
    }

    function validOwnerCancellation(engagementId) {
      let from = currentEngagementStatus();
      let missionAfter = getAfter(
        /databases/$(database)/documents/missions/$(resource.data.missionId)
      ).data;
      return canUseProfessionalOwnerWritePath()
        && engagementId == resource.data.missionId + '_' + request.auth.uid
        && resource.data.volunteerId == request.auth.uid
        && resource.data.mobilizationId == missionAfter.mobilizationId
        && isActiveMobilization(resource.data.mobilizationId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
        && (from == 'pending' || from == 'standby' || from == 'confirmed')
        && (from == 'pending'
          || from == 'standby'
          || missionAfter.updatedAt == request.time);
    }

    function validOwnerReengagement(engagementId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let mission = get(
        /databases/$(database)/documents/missions/$(resource.data.missionId)
      ).data;
      return canUseProfessionalOwnerWritePath()
        && engagementId == resource.data.missionId + '_' + request.auth.uid
        && resource.data.volunteerId == request.auth.uid
        && resource.data.mobilizationId == mission.mobilizationId
        && isActiveMobilization(resource.data.mobilizationId)
        && (resource.data.status == 'cancelled'
          || resource.data.status == 'pending')
        && changed.hasOnly(['status', 'updatedAt', 'profession'])
        && request.resource.data.status == 'confirmed'
        && request.resource.data.updatedAt == request.time
        && validProfession(request.resource.data.profession)
        && existsAfter(volunteerPath(request.auth.uid))
        && getAfter(volunteerPath(request.auth.uid)).data.uid
          == request.auth.uid
        && getAfter(volunteerPath(request.auth.uid)).data.profession
          == request.resource.data.profession
        && mission.isActive == true
        && mission.status != 'cancelled'
        && request.time < mission.endAt
        && getAfter(
          /databases/$(database)/documents/missions/$(resource.data.missionId)
        ).data.updatedAt == request.time;
    }

    match /locations/{locationId} {
      // La projection publique RC3 reste limitée aux 65 sites Gironde, qui
      // portent soit le propriétaire legacy explicite, soit aucun champ
      // organisationnel. Les sites RC4 explicites exigent une identité
      // privilégiée appartenant à leur organisation.
      allow get, list: if isLegacyPublicLocation(resource.data)
        || canReadPrivilegedLocation(locationId, resource.data);
      allow create, update, delete: if false;
    }

    match /missions/{missionId} {
      allow get: if isActiveMobilization(resource.data.mobilizationId)
        && canReadMissionScope(
          resource.data.mobilizationId,
          resource.data.locationId
        )
        && (resource.data.isActive == true
          || (isSignedIn()
            && exists(engagementPath(missionId, request.auth.uid)))
          || canManageLocation(resource.data.locationId)
          || canReadOrganizationMissionScope(
            resource.data.mobilizationId,
            resource.data.locationId
          ));
      allow list: if resource.data.isActive == true
        && isActiveMobilization(resource.data.mobilizationId)
        && canReadMissionScope(
          resource.data.mobilizationId,
          resource.data.locationId
        );
      allow create: if isSignedIn() && validMissionCreate(missionId);
      allow update: if existsAfter(
          engagementPath(missionId, request.auth.uid)
        ) && validMissionCounterUpdate(missionId);
      allow update: if !existsAfter(
          engagementPath(missionId, request.auth.uid)
        ) && (validManagedMissionCounterUpdate() || validMissionCancellation());
      allow delete: if false;
    }

    match /volunteers/{uid} {
      allow create: if isVolunteerOwner(uid)
        && canUseProfessionalOwnerWritePath()
        && validVolunteerData(uid)
        && isUnverifiedProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVolunteerOwner(uid)
        && canUseProfessionalOwnerWritePath()
        && validVolunteerData(uid)
        && clientVerificationUpdateIsSafe()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow read: if isVolunteerOwner(uid);
      allow delete: if false;
    }

    match /engagements/{engagementId} {
      allow create: if validEngagementCreate(engagementId);
      allow get: if canGetOwnEngagement(engagementId)
        && (!exists(
            /databases/$(database)/documents/engagements/$(engagementId)
          ) || isActiveMobilization(resource.data.mobilizationId));
      allow get: if isAssignedOrLegacyCoordinatorForMobilization(
          resource.data.mobilizationId
        )
        && canUseMobilizationOrganizationAsRole(
          resource.data.mobilizationId
        )
        && isActiveMobilization(resource.data.mobilizationId);
      allow get: if canReadOrganizationEngagement(resource.data)
        && isActiveMobilization(resource.data.mobilizationId);
      allow list: if isAssignedOrLegacyCoordinatorForMobilization(
          resource.data.mobilizationId
        )
        && canUseMobilizationOrganizationAsRole(
          resource.data.mobilizationId
        )
        && isActiveMobilization(resource.data.mobilizationId);
      allow list: if canReadOrganizationEngagement(resource.data)
        && isActiveMobilization(resource.data.mobilizationId);
      allow update: if resource.data.volunteerId == request.auth.uid
        && (validOwnerCancellation(engagementId)
          || validOwnerReengagement(engagementId));
      allow update: if resource.data.volunteerId != request.auth.uid
        && validEngagementStatusUpdate();
      allow delete: if false;
    }

    match /notificationEvents/{eventId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /professionalSolicitationJournal/{entryId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt'])
        && (request.resource.data.readAt == null
          || request.resource.data.readAt == request.time);
      allow create, delete: if false;
    }

    match /notificationPreferences/{uid} {
      allow get: if isVolunteerOwner(uid);
      allow create, update: if isVolunteerOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'compatibleMissions', 'engagementUpdates',
          'operationalAlerts', 'quietHoursStart', 'quietHoursEnd',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.compatibleMissions is bool
        && request.resource.data.engagementUpdates is bool
        && request.resource.data.operationalAlerts is bool
        && request.resource.data.quietHoursStart is int
        && request.resource.data.quietHoursStart >= 0
        && request.resource.data.quietHoursStart <= 23
        && request.resource.data.quietHoursEnd is int
        && request.resource.data.quietHoursEnd >= 0
        && request.resource.data.quietHoursEnd <= 23
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow get: if isSignedIn()
        && ((!exists(
              /databases/$(database)/documents/pushSubscriptions/$(subscriptionId)
            )
            && subscriptionId.matches('^' + request.auth.uid + '_.+$'))
          || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'installationId', 'token', 'platform', 'active',
          'lastUsedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && subscriptionId == request.auth.uid + '_'
          + request.resource.data.installationId
        && isNonBlankCanonicalText(request.resource.data.installationId)
        && request.resource.data.installationId.size() <= 160
        && isNonBlankCanonicalText(request.resource.data.token)
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'web'
        && request.resource.data.active == true
        && request.resource.data.lastUsedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && subscriptionId == request.auth.uid + '_'
          + resource.data.installationId
        && request.resource.data.installationId == resource.data.installationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'active', 'lastUsedAt', 'updatedAt'
        ])
        && isNonBlankCanonicalText(request.resource.data.token)
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'web'
        && request.resource.data.active is bool
        && request.resource.data.lastUsedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /adminInvitations/{invitationId} {
      allow read: if isCoordinator();
      allow create: if isCoordinator()
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'locationIds', 'createdBy',
          'createdAt', 'expiresAt', 'status', 'acceptedAt'
        ])
        && isValidAdminInvitationEmail(request.resource.data.email)
        && isNonBlankCanonicalText(request.resource.data.displayName)
        && request.resource.data.role in ['site_manager', 'coordinator']
        && hasValidInvitationScope(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.acceptedAt == null;
      allow update: if isCoordinator()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status']);
      allow delete: if false;
    }

    match /roles/{uid} {
      allow get: if isVolunteerOwner(uid);
      allow list: if isPlatformAdministrator();
      allow create, update, delete: if false;
    }

    match /platformAdministrators/{uid} {
      allow get: if isVolunteerOwner(uid);
      allow list, write: if false;
    }

    match /territories/{territoryId} {
      allow read: if isPlatformAdministrator();
      allow write: if false;
    }

    match /mobilizations/{mobilizationId} {
      allow get: if isPlatformAdministrator()
        || (isActiveMobilization(mobilizationId)
          && ((isSignedIn()
              && isPlatformDiscoverableMobilization(
                mobilizationId,
                resource.data
              ))
            || hasMobilizationOrganizationMembership(resource.data)
            || (canReadMobilizationOrganization(resource.data)
              && (isAssignedOrLegacyCoordinatorForMobilization(mobilizationId)
                || isActiveSiteManager()))));
      allow list: if isPlatformAdministrator()
        || (isSignedIn()
          && !isPlatformAdministrator()
          && resource.data.status == 'active'
          && (isExplicitPlatformDiscoverableMobilization(resource.data)
            || hasMobilizationOrganizationMembership(resource.data)
            || (isActiveSiteManager()
              && canReadMobilizationOrganization(resource.data))));
      allow write: if false;
    }

    match /mobilizationAssignments/{assignmentId} {
      allow get, list: if isPlatformAdministrator()
        || (isCoordinator()
          && resource.data.uid == request.auth.uid
          && resource.data.role == 'coordinator');
      allow write: if false;
    }

    match /operations/{operationId} {
      allow get: if isPlatformAdministrator()
        || canReadOperationOrganization(resource.data)
        || (isSignedIn()
          && isPlatformDiscoverableOperation(resource.data));
      allow list: if isPlatformAdministrator()
        || canReadOperationOrganization(resource.data)
        || (isSignedIn()
          && isExplicitPlatformDiscoverableOperation(resource.data));
      allow write: if false;
    }

    match /organizations/{organizationId} {
      allow get, list: if isPlatformAdministrator()
        || hasActiveOrganizationMembership(organizationId);
      allow create, update, delete: if false;
    }

    match /organizationMemberships/{membershipId} {
      allow get: if isPlatformAdministrator()
        || canReadOwnOrganizationMembership(membershipId)
        || canOrganizationAdminReadMembership(membershipId);
      allow list: if isPlatformAdministrator()
        || (isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid)
        || canOrganizationAdminListMembership();
      allow create, update, delete: if false;
    }

    match /platform/{documentId} {
      allow get: if isSignedIn() && documentId == 'config';
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
