{
  "name": "mobsante-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:emulator": "MOBSANTE_APP_URL=http://127.0.0.1:5000/activation MOBSANTE_EMULATOR_FAIL_INVITATION_IDS=failure-new,failure-existing firebase emulators:exec --config ../firebase.json --only auth,firestore,functions --project demo-mobsante \"node --test --test-concurrency=1 test/emulator/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "firebase": "^12.0.0",
    "firebase-tools": "^15.24.0"
  }
}
